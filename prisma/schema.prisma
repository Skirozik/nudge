generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  phone             String             @unique
  timezone          String             @default("America/New_York")
  persona           String             @default("coach")
  createdAt         DateTime           @default(now())
  optedOut          Boolean            @default(false)
  source            String?
  locationToken     String?            @unique
  // SeatSnipe: school id from src/lib/schools (null until the student picks one)
  school            String?
  // A watch request sent before the student picked a school; replayed once they do
  pendingWatchQuery String?
  pendingWatchAt    DateTime?
  // What they came for: 'seatsnipe' | 'nudge' | 'both' (src/lib/pick.ts). Asked on a
  // new number's first text; past users got one from their history. Null = no lean.
  product           String?
  // Where a new number is in the welcome: 'new' (no text handled yet),
  // 'awaiting_product' (asked SeatSnipe or Nudge) or 'awaiting_school' (picked
  // SeatSnipe, asked their school). Null once the welcome is done.
  onboarding        String?
  // What they asked for before or with their pick, held during the welcome and
  // answered once they pick: JSON [{ "text", "at" }], each with its send time
  onboardingHeld    String?
  // SeatSnipe referrals: their own code (made when they first need it), and a
  // real code from their first text. Only createUser's insert writes referredByCode.
  referralCode      String?            @unique
  referredByCode    String?
  assignments       Assignment[]
  conversation      Conversation?
  messages          Message[]
  sessions          Session[]
  oneOffReminders   OneOffReminder[]
  watches           Watch[]
  locationReminders LocationReminder[]
  payments          Payment[]
  classPasses       ClassPass[]
  credits           Credit[]
  creditOffers      CreditOffer[]
  referralsMade     Referral[]         @relation("referrer")
  referredBy        Referral?          @relation("friend")
}

model Assignment {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  title           String
  course          String?
  dueAt           DateTime
  reminderOffsets Int[]      @default([24])
  nudgeMode       String     @default("basic")
  status          Status     @default(open)
  source          Source     @default(text)
  checkIn         Boolean    @default(false)
  checkInAt       DateTime?
  createdAt       DateTime   @default(now())
  reminders       Reminder[]
}

enum Status {
  open
  done
  canceled
}

enum Source {
  text
  screenshot
}

model Reminder {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  sendAt       DateTime
  sent         Boolean    @default(false)
  sentAt       DateTime?
  bullmqJobId  String?
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  messages  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Message {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  direction Direction
  body      String
  createdAt DateTime  @default(now())
}

enum Direction {
  in
  out
}

model OneOffReminder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  message     String
  fireAt      DateTime
  sent        Boolean  @default(false)
  persistent  Boolean  @default(false)
  bullmqJobId String?
  createdAt   DateTime @default(now())
}

model OtpCode {
  id             String   @id @default(uuid())
  phone          String
  code           String
  expiresAt      DateTime
  used           Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Location Reminders ─────────────────────────────────────────────────────

model LocationReminder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  location        String
  message         String
  active          Boolean   @default(true)
  persistent      Boolean   @default(false)
  recurring       Boolean   @default(false)
  lastFiredAt     DateTime?
  cooldownMinutes Int       @default(120)
  createdAt       DateTime  @default(now())
}

// ── SeatSnipe ──────────────────────────────────────────────────────────────

enum WatchStatus {
  ACTIVE
  PAUSED
  FULFILLED
  CANCELLED
  EXPIRED
}

model Watch {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  school        String      @default("gsu")
  term          String
  crn           String
  courseCode    String
  sectionLabel  String?
  status        WatchStatus @default(ACTIVE)
  lastSeats     Int         @default(0)
  lastCheckedAt DateTime?
  alertCount    Int         @default(0)
  lastAlertAt   DateTime?
  source        String?
  createdAt     DateTime    @default(now())

  @@unique([userId, school, term, crn])
}

model SeatEvent {
  id         String   @id @default(cuid())
  school     String   @default("gsu")
  term       String
  crn        String
  seatsFrom  Int
  seatsTo    Int
  observedAt DateTime @default(now())
}

model MetricEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  meta      Json?
  createdAt DateTime @default(now())
}

// ── SeatSnipe payments ─────────────────────────────────────────────────────
// Statuses are text, not enums, so an older worker client can still read a row
// with a status it doesn't know. Only userId is a foreign key; the links between
// these tables are plain ids, so NEWUSER OFF can delete them in any order.
// An openKey is set only while a row is open and cleared on every move out of
// it, so the unique index allows one open row at a time (Postgres allows many NULLs).

// One $5 link for one class. It's also the outbox row, and what Stripe marks paid.
model Payment {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  school                String
  // Saved when the link is made, never re-read from getActiveTerm's cache
  term                  String
  courseCode            String
  // Sections to start once it's paid
  crns                  String[]
  // Seats open in crns[0] when the link was made. Above 0, the link text says so first.
  openSeatsAtLink       Int?
  // pending | paid | expired | cancelled | duplicate
  status                String    @default("pending")
  // "userId|school|term|courseCode" while pending
  openKey               String?   @unique
  amountCents           Int       @default(500)
  stripeSessionId       String?   @unique
  stripePaymentIntentId String?   @unique
  url                   String?
  livemode              Boolean?
  // createdAt + 24h
  expiresAt             DateTime
  // Claims, so each text goes out once
  sentAt                DateTime?
  remindedAt            DateTime?
  paidAt                DateTime?
  // What activation found, so a retried job sends the same text
  outcome               Json?
  activatedAt           DateTime?
  confirmedAt           DateTime?
  firstLinkAt           DateTime?
  // Full refunds only
  refundedAt            DateTime?
  disputedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId, status])
}

// "This class is paid for this term", so re-arms, other sections and
// cancel/re-add start without another $5.
model ClassPass {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  school         String
  term           String
  courseCode     String
  // stripe | credit | free (Stripe wasn't live when it should have been)
  via            String
  paymentId      String?   @unique
  creditId       String?   @unique
  // First seat alert (or seats-open note) for this class. Watch.alertCount resets on re-arm.
  firstAlertAt   DateTime?
  // The end-of-term free class was given (or the class was gone)
  noSeatCreditAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, school, term, courseCode])
}

// A free class. The unique key means one source can't grant twice.
model Credit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  // referral | no_seat | class_gone | duplicate | comp
  reason    String
  // Referral.id, ClassPass.id, Payment.id or "comp:<message guid>"
  sourceId  String?
  // End of the semester after the one it was earned in
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([reason, sourceId])
  @@index([userId, usedAt, expiresAt])
}

// The open "use your free class?" question. One per user at a time.
model CreditOffer {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  school      String
  term        String
  courseCode  String
  crns        String[]
  // The credit YES used
  creditId    String?
  // asked | yes | no | superseded | expired
  status      String    @default("asked")
  // userId while asked
  openKey     String?   @unique
  reasked     Boolean   @default(false)
  sentAt      DateTime?
  outcome     Json?
  activatedAt DateTime?
  confirmedAt DateTime?
  // Starts the 24h clock
  createdAt   DateTime  @default(now())
}

// A referral that paid out (or hit the cap). A friend pays out once, and the
// slot key holds the cap of 3 even when friends pay at the same moment.
model Referral {
  // Made in code, so the credit can point at it in the same transaction
  id         String    @id
  referrerId String
  referrer   User      @relation("referrer", fields: [referrerId], references: [id])
  friendId   String    @unique
  friend     User      @relation("friend", fields: [friendId], references: [id])
  paymentId  String    @unique
  // semesterOf(paidAt), like "2026-fall"
  semester   String
  // 1 to 3 when earned, null when capped
  slot       Int?
  creditId   String?   @unique
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([referrerId, semester, slot])
}

// ── Grade history ──────────────────────────────────────────────────────────
// One row per section per past term, from the grade distributions a school
// publishes (GSU: dssapex.gsu.edu). scripts/load-grades.ts loads them.

model GradeSection {
  id         String   @id @default(cuid())
  school     String
  // Banner term code, like "202601"
  term       String
  crn        String
  // "MATH 2212"
  courseCode String
  // As the grade file spells it; matched to Banner's by sameInstructor()
  instructor String
  a          Int
  b          Int
  c          Int
  d          Int
  f          Int
  w          Int
  wf         Int
  // Audits, incompletes and pass/fail: not in the GPA or the DFW rate
  other      Int
  // The file's own course average (plus/minus scale). Null when no one got a letter grade
  gpa        Float?
  createdAt  DateTime @default(now())

  @@unique([school, term, crn])
  @@index([school, courseCode, term])
}
