generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  phone             String             @unique
  timezone          String             @default("America/New_York")
  persona           String             @default("coach")
  createdAt         DateTime           @default(now())
  optedOut          Boolean            @default(false)
  source            String?
  locationToken     String?            @unique
  // SeatSnipe: school id from src/lib/schools (null until the student picks one)
  school            String?
  // A watch request sent before the student picked a school; replayed once they do
  pendingWatchQuery String?
  pendingWatchAt    DateTime?
  // What they came for: 'seatsnipe' | 'nudge' | 'both' (src/lib/pick.ts). Asked on a
  // new number's first text; past users got one from their history. Null = no lean.
  product           String?
  // Where a new number is in the welcome: 'new' (no text handled yet),
  // 'awaiting_product' (asked SeatSnipe or Nudge) or 'awaiting_school' (picked
  // SeatSnipe, asked their school). Null once the welcome is done.
  onboarding        String?
  // What they asked for before or with their pick, held during the welcome and
  // answered once they pick: JSON [{ "text", "at" }], each with its send time
  onboardingHeld    String?
  assignments       Assignment[]
  conversation      Conversation?
  messages          Message[]
  sessions          Session[]
  oneOffReminders   OneOffReminder[]
  watches           Watch[]
  locationReminders LocationReminder[]
}

model Assignment {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  title           String
  course          String?
  dueAt           DateTime
  reminderOffsets Int[]      @default([24])
  nudgeMode       String     @default("basic")
  status          Status     @default(open)
  source          Source     @default(text)
  checkIn         Boolean    @default(false)
  checkInAt       DateTime?
  createdAt       DateTime   @default(now())
  reminders       Reminder[]
}

enum Status {
  open
  done
  canceled
}

enum Source {
  text
  screenshot
}

model Reminder {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  sendAt       DateTime
  sent         Boolean    @default(false)
  sentAt       DateTime?
  bullmqJobId  String?
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  messages  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model Message {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  direction Direction
  body      String
  createdAt DateTime  @default(now())
}

enum Direction {
  in
  out
}

model OneOffReminder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  message     String
  fireAt      DateTime
  sent        Boolean  @default(false)
  persistent  Boolean  @default(false)
  bullmqJobId String?
  createdAt   DateTime @default(now())
}

model OtpCode {
  id             String   @id @default(uuid())
  phone          String
  code           String
  expiresAt      DateTime
  used           Boolean  @default(false)
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique @default(uuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Location Reminders ─────────────────────────────────────────────────────

model LocationReminder {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  location        String
  message         String
  active          Boolean   @default(true)
  persistent      Boolean   @default(false)
  recurring       Boolean   @default(false)
  lastFiredAt     DateTime?
  cooldownMinutes Int       @default(120)
  createdAt       DateTime  @default(now())
}

// ── SeatSnipe ──────────────────────────────────────────────────────────────

enum WatchStatus {
  ACTIVE
  PAUSED
  FULFILLED
  CANCELLED
  EXPIRED
}

model Watch {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  school        String      @default("gsu")
  term          String
  crn           String
  courseCode    String
  sectionLabel  String?
  status        WatchStatus @default(ACTIVE)
  lastSeats     Int         @default(0)
  lastCheckedAt DateTime?
  alertCount    Int         @default(0)
  lastAlertAt   DateTime?
  source        String?
  createdAt     DateTime    @default(now())

  @@unique([userId, school, term, crn])
}

model SeatEvent {
  id         String   @id @default(cuid())
  school     String   @default("gsu")
  term       String
  crn        String
  seatsFrom  Int
  seatsTo    Int
  observedAt DateTime @default(now())
}

model MetricEvent {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  meta      Json?
  createdAt DateTime @default(now())
}
